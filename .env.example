# ==============================================================================
# MyShop Backend Engine - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection URL (Prisma PostgreSQL)
# Local non-docker: postgresql://postgres:postgres@localhost:5432/myshop_db?schema=public
# Docker-compose internally overrides host to 'postgres'
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/myshop_db?schema=public"

# PostgreSQL Credentials (used by docker-compose for database container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myshop_db
DOCKER_POSTGRES_PORT=5434

# Security & JWT Authentication
# IMPORTANT: Generate a strong, random 32+ character secret for production
JWT_SECRET=myshop_super_secret_jwt_key_2026_prod
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated URLs)
# E.g. http://localhost:3000 (myshop), http://localhost:3001 (myshop_capital), http://10.124.107.203:3000
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://10.124.107.203:3000,http://10.124.107.203:3001"

# Rate Limiting & DDoS Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=15

# Database Seeding on Docker Startup (true to automatically seed initial accounts/inventory)
SEED_DATABASE=false
