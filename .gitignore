# ==============================================================================
# Git Ignore Configuration for MyShop Backend (Node.js / TypeScript / Prisma)
# ==============================================================================

# Dependencies
node_modules/
jspm_packages/
.pnp
.pnp.js

# Production and TypeScript Build Outputs
dist/
build/
out/
*.tsbuildinfo

# Environment & Secret Files (CRITICAL: Never commit sensitive credentials)
.env
.env.production
.env.staging
.env.development
.env.local
.env.*.local

# Explicitly track environment templates:
!.env.example

# Logs and Process IDs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# Test Coverage and Temporary Testing Artifacts
coverage/
.nyc_output/
*.lcov

# Prisma & Database Local Artifacts
prisma/*.db
prisma/*.db-journal

# IDE and Editor Configuration
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker Local Volume Dumps
postgres_data/
